# Supabase Configuration
# These are public-facing keys for client-side usage
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

# Server-side only: Service role key (NEVER expose to client)
# This should be set in your server environment variables, not in .env files
# SUPABASE_SERVICE_ROLE_KEY=

# Base URL of the Express + MongoDB API (see /server). Include the /api suffix.
# Local development: http://localhost:4000/api
# Production: https://your-backend-url.com/api
VITE_API_URL=
