# =============================================================================
# RideProfit Tracker / Vehicle Calculation System — Environment Configuration
# =============================================================================
# Copy this file to .env or configure these variables in your deployment settings.
# NEVER commit actual secret credentials, passwords, or production keys.

# -----------------------------------------------------------------------------
# 1. Database Configuration (Required in Production)
# -----------------------------------------------------------------------------
# Primary PostgreSQL connection string. Precedence: DATABASE_URL > POSTGRES_URL.
# In production, PostgreSQL is required; fallback to JSON storage is disallowed.
# In local development, if unset, defaults to local data/db.json file.
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
DATABASE_URL=postgresql://postgres:your-db-password@your-host:5432/rideprofit?sslmode=require

# Alternative PostgreSQL URL (used by platforms like Vercel Postgres / Neon / Railway).
POSTGRES_URL=
# Additional aliases: SUPABASE_DB_URL, POSTGRESQL_URL, PG_URL, PG_CONNECTION_STRING

# -----------------------------------------------------------------------------
# 2. Authentication & Token Signing (Required in Production)
# -----------------------------------------------------------------------------
# Cryptographically strong secret key used for signing session HMAC bearer tokens.
# Must be at least 32 characters in production. Supported aliases: TOKEN_SECRET, JWT_SECRET, SUPABASE_JWT_SECRET, AUTH_SECRET.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=your-random-32-character-token-secret-string-here
# Optional alias if your deployment uses JWT_SECRET:
# JWT_SECRET=your-random-32-character-token-secret-string-here

# -----------------------------------------------------------------------------
# 3. Security & CORS (Optional)
# -----------------------------------------------------------------------------
# Trusted origin(s) allowed for Cross-Origin requests (comma-separated).
# If unset, defaults safely to same-origin in production, localhost in development.
CORS_ORIGIN=https://your-domain.com

# Reverse proxy trust flag (1 or true to trust X-Forwarded-For headers).
TRUSTED_PROXY=1

# -----------------------------------------------------------------------------
# 4. Email Delivery — Resend (Optional in Dev, Required for Production OTP)
# -----------------------------------------------------------------------------
# API key from resend.com for transactional email delivery (OTP verification & password reset).
RESEND_API_KEY=re_your_resend_api_key

# Sender email address verified in your Resend account.
RESEND_FROM=RideProfit <notifications@yourdomain.com>

# -----------------------------------------------------------------------------
# 5. Client API Configuration (Optional)
# -----------------------------------------------------------------------------
# Base URL for frontend API calls. If unset, the browser uses the current origin window.location.origin.
VITE_API_URL=

# -----------------------------------------------------------------------------
# 6. External Supabase Integration (Optional)
# -----------------------------------------------------------------------------
# Only required if connecting to an external Supabase project for auth/storage.
# The app functions fully with its native PostgreSQL store and built-in auth.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=
SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=