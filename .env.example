# --- Server ----------------------------------------------------------------

# Signs auth tokens. Optional: when unset, a random secret is generated once and
# stored in data/.token-secret (if set, use at least 16 characters).
TOKEN_SECRET=

# Email delivery for login / password-reset codes (https://resend.com).
# Without these the app cannot email codes: in development the code is printed
# to the server console, in production the flow is disabled.
RESEND_API_KEY=
RESEND_FROM="Jay Mataji Transport <onboarding@resend.dev>"

# --- Client -----------------------------------------------------------------

# Optional override for the API origin; defaults to the current origin.
VITE_API_URL=

# Optional real Supabase project; when unset the built-in /api auth backend is used.
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

CORS_ORIGIN=
