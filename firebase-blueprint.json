{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private authenticated fleet operator profile stored at /users/{userId}",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "email": { "type": "string", "format": "email", "minLength": 3, "maxLength": 255 },
        "fullName": { "type": "string", "maxLength": 80 },
        "mobile": { "type": "string", "maxLength": 20 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "fullName", "mobile", "createdAt", "updatedAt"]
    },
    "Vehicle": {
      "title": "Vehicle",
      "description": "Fleet vehicle owned by a user",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "name": { "type": "string", "maxLength": 255 },
        "type": { "type": "string", "minLength": 1, "maxLength": 80 },
        "model": { "type": "string", "maxLength": 255 },
        "vehicleNumber": { "type": "string", "maxLength": 64 },
        "notes": { "type": "string", "maxLength": 2000 },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "name",
        "type",
        "model",
        "vehicleNumber",
        "notes",
        "isActive",
        "createdAt",
        "updatedAt"
      ]
    },
    "Trip": {
      "title": "Trip",
      "description": "Vehicle trip accounting entry",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "vehicleId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "maxLength": 10 },
        "income": { "type": "number" },
        "diesel": { "type": "number" },
        "driverPayment": { "type": "number" },
        "emiShare": { "type": "number" },
        "otherExpenseItems": { "type": "array" },
        "otherExpenses": { "type": "number" },
        "notes": { "type": "string", "maxLength": 2000 },
        "route": { "type": "string", "maxLength": 120 },
        "driverName": { "type": "string", "maxLength": 80 },
        "totalKm": { "type": "number" },
        "dieselLiters": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "vehicleId",
        "date",
        "income",
        "diesel",
        "driverPayment",
        "emiShare",
        "otherExpenseItems",
        "otherExpenses",
        "notes",
        "route",
        "driverName",
        "totalKm",
        "dieselLiters",
        "createdAt",
        "updatedAt"
      ]
    },
    "AppSettings": {
      "title": "AppSettings",
      "description": "Account-scoped company and preference settings",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "appName": { "type": "string", "maxLength": 120 },
        "transportationName": { "type": "string", "maxLength": 120 },
        "businessName": { "type": "string", "maxLength": 120 },
        "currency": { "type": "string", "minLength": 1, "maxLength": 10 },
        "defaultVehicleId": { "type": "string", "maxLength": 128 },
        "fullName": { "type": "string", "maxLength": 80 },
        "mobileNumber": { "type": "string", "maxLength": 20 },
        "address": { "type": "string", "maxLength": 500 },
        "contactNumber": { "type": "string", "maxLength": 20 },
        "businessEmail": { "type": "string", "maxLength": 255 },
        "userRole": { "type": "string", "maxLength": 50 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "appName",
        "transportationName",
        "businessName",
        "currency",
        "defaultVehicleId",
        "fullName",
        "mobileNumber",
        "address",
        "contactNumber",
        "businessEmail",
        "userRole",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user account profile"
    },
    "/users/{userId}/vehicles/{vehicleId}": {
      "schema": { "$ref": "#/entities/Vehicle" },
      "description": "Fleet vehicles belonging to the user"
    },
    "/users/{userId}/trips/{tripId}": {
      "schema": { "$ref": "#/entities/Trip" },
      "description": "Vehicle trip records belonging to the user"
    },
    "/users/{userId}/settings/{settingId}": {
      "schema": { "$ref": "#/entities/AppSettings" },
      "description": "Application and company profile settings for the user"
    }
  }
}
